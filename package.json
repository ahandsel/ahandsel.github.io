{
  "name": "ahandsel.github.io",
  "version": "1.0.0",
  "private": false,
  "description": "My portfolio site built with VitePress",
  "keywords": [
    "resume",
    "markdown",
    "localization-engineer",
    "developer-advocate",
    "linkedin",
    "ai-workflows",
    "履歴書",
    "マークダウン",
    "ローカリゼーションエンジニア",
    "デベロッパーアドボケイト",
    "リンクトイン",
    "AI ワークフロー"
  ],
  "homepage": "https://ahandsel.github.io",
  "bugs": {
    "url": "https://github.com/ahandsel/ahandsel.github.io/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahandsel/ahandsel.github.io.git"
  },
  "license": "MIT",
  "author": "ahandsel",
  "type": "module",
  "scripts": {
    "ai": "claude",
    "check": "pnpm lint && pnpm test && pnpm typecheck && pnpm lint-naming && pnpm license && pnpm check-en-ja-parity && pnpm tree && pnpm vitepress-build",
    "check-en-ja-parity": "node scripts/check-en-ja-parity.mjs",
    "clean": "rm -rf contents/.vitepress/cache contents/.vitepress/dist",
    "cleanup": "zsh ./scripts/cleanup-temp-files.sh",
    "dev": "pnpm lint && pnpm tree && pnpm vitepress-dev",
    "index": "zsh scripts/index.sh",
    "license": "license-manager analyze --config license-manager.config.cjs",
    "lint": "pnpm run lint-code && pnpm run lint-md",
    "lint-code": "prettier --write .",
    "lint-contents": "prettier --write contents && markdownlint-cli2 --fix \"contents/**/*.md\"",
    "lint-md": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint-naming": "node skills/file-folder-name-linter/scripts/lint-names.mjs",
    "preview": "pnpm vitepress-build && pnpm vitepress-preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test-tree": "node scripts/generate-doc-structure.mjs --check",
    "tree": "node scripts/generate-doc-structure.mjs",
    "typecheck": "vue-tsc --noEmit",
    "vitepress-build": "vitepress build contents",
    "vitepress-dev": "vitepress dev contents",
    "vitepress-preview": "vitepress preview contents",
    "vitepress-update": "pnpm add -D vitepress@next"
  },
  "devDependencies": {
    "@cybozu/license-manager": "1.4.2",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^26.6.3",
    "markdownlint-cli2": "^0.23.3",
    "markdownlint-rule-relative-links": "^5.1.3",
    "markdownlint-rule-search-replace": "^1.2.0",
    "prettier": "^3.9.9",
    "prettier-plugin-autocorrect": "^0.4.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-toml": "^3.0.2",
    "sh-syntax": "^0.7.0",
    "tree-extended": "^4.6.0",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-plugin-llms": "^1.14.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.12",
    "pnpm": ">=10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.12",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
