// https://github.com/DavidAnson/markdownlint-cli2

{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",

  // Base markdownlint rule config
  "config": {
    "blanks-around-fences": true,
    "MD004": { "style": "asterisk" },
    "MD007": { "indent": 2 },
    "MD009": { "br_spaces": 2 },
    "MD012": { "maximum": 2 },
    "MD013": false,
    "MD014": false,
    "MD022": { "lines_above": 2, "lines_below": 1 },
    "MD024": false,
    "MD025": { "front_matter_title": "{{$frontmatter.title}}" },
    "MD026": false,
    "MD029": { "style": "ordered" },
    "MD032": false,
    "MD033": {
      "allowed_elements": [
        "br",
        "pre",
        "script",
        "ul",
        "li",
        "ol",
        "RepoCards",
      ],
    },
    "MD036": false,
    "search-replace": {
      "rules": [
        {
          "name": "curly-double-quotes",
          "message": "Do not use curly double quotes.",
          "searchPattern": "/\u201c|\u201d/g",
          "replace": "\"",
        },
        {
          "name": "curly-single-quotes",
          "message": "Do not use curly single quotes.",
          "searchPattern": "/\u2018|\u2019/g",
          "replace": "'",
        },
        {
          "name": "em-dash",
          "message": "Do not use em dashes.",
          "searchPattern": "/\u2014/g",
          "replace": "-",
        },
        {
          "name": "en-dash",
          "message": "Do not use en dashes. Use a hyphen instead.",
          "searchPattern": "/\u2013/g",
          "replace": "-",
        },
        {
          "name": "non-breaking-space",
          "message": "Do not use non-breaking spaces. Use a regular space instead.",
          "searchPattern": "/\u00a0/g",
          "replace": " ",
        },
        {
          "name": "object-replacement-character",
          "message": "Do not use the object replacement character. Use a regular space instead.",
          "searchPattern": "/\ufffc/g",
          "replace": " ",
        },
      ],
    },
  },
  "customRules": [
    "markdownlint-rule-search-replace",
    "markdownlint-rule-relative-links",
  ],

  // Files to lint
  "gitignore": true,
  "globs": ["**/*.md"],

  // Vendored content from upstream plugins/repos - keep pristine for re-sync.
  // Covers the canonical copy under skills/ and the mirrored copies under
  // .claude/skills/ and .github/skills/.
  "ignores": [
    // All figma-* skills are vendored from the official Figma plugin.
    "**/skills/figma-*/**",
    // .claude/commands is a symlink to prompts/; lint the canonical copy only.
    ".claude/commands/**",
  ],

  // Each file takes the first override whose filter matches it, so keep the vendored skills override first.
  "overrides": [
    // Vendored third-party skills, imported with their upstream LICENSE files, get the asterisk bullet rule only.
    // Every other rule stays off so the rest of the text matches upstream for re-sync.
    {
      "filter": [
        "**/skills/gh-address-comments/**",
        "**/skills/gh-fix-ci/**",
        "**/skills/playwright/**",
        "**/skills/security-best-practices/**",
        "**/skills/security-threat-model/**",
      ],
      "combine": "replace",
      "config": { "default": false, "MD004": { "style": "asterisk" } },
    },
    // Copilot mirrors under .github/skills/ get every rule except relative-links.
    // Their relative links are written for the skills/ depth, one level up, and
    // the canonical skills/ tree already checks them.
    {
      "filter": [".github/skills/**"],
      "combine": "merge",
      "config": { "relative-links": false },
    },
  ],

  // Optional CLI behavior
  "fix": true,
  "noProgress": false,
  "showFound": true,
}
